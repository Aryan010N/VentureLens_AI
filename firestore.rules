rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile records:
    // In production, each user can only read/write their own document.
    // When using backend service account (Admin SDK), these rules are bypassed.
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Corporate workspace, projects, and optimization run records:
    match /companies/{companyId} {
      allow read, write: if true;
      
      // Projects subcollection: companies/{companyId}/projects/{projectId}
      match /projects/{projectId} {
        allow read, write: if true;
      }
      
      // Run history subcollection: companies/{companyId}/runs/{runId}
      match /runs/{runId} {
        allow read, write: if true;
      }
    }
    
    // Fallback: deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
